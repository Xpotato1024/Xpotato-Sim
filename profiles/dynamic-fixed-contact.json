{
  "schema_version": "xpotato-sim-launch-profile/v4",
  "name": "dynamic-fixed-contact",
  "workspace": "..",
  "mode": "simulation",
  "robot": {
    "name": "fast_arm",
    "version": 1
  },
  "input": {
    "plugin": {
      "name": "viewer",
      "version": 1
    },
    "provider": "gamepad/v1",
    "preset": null
  },
  "mapping": {
    "plugin": {
      "name": "viewer_keyboard_gamepad_mapping",
      "version": 1
    },
    "parameters": {
      "gamepad_trigger_control": {
        "schema": "gamepad-trigger-control/v1",
        "output_side": "left",
        "neutral_threshold": 0.1,
        "left": {
          "axes": [
            1,
            0
          ],
          "signs": [
            -1,
            -1
          ],
          "trigger_button": 6,
          "sign_button": 4
        },
        "right": {
          "axes": [
            3,
            2
          ],
          "signs": [
            -1,
            -1
          ],
          "trigger_button": 7,
          "sign_button": 5
        }
      }
    }
  },
  "execution": {
    "steps": 18000,
    "dt_s": 0.016666666666666666,
    "interval_s": 0.016666666666666666,
    "grace_period_s": 60,
    "dynamics": {
      "schema_version": "dynamics-settings/v1",
      "semantics": "coordinated_actuator_servo_dynamic/v1",
      "physics_dt_s": 0.0016666666666666668,
      "integrator": "implicitfast",
      "solver": "Newton",
      "iterations": 50,
      "tolerance": 1e-10,
      "max_joint_speed_rad_s": 10.0,
      "max_tracking_error_rad": 0.75
    }
  },
  "web": {
    "host": "127.0.0.1",
    "port": 5174,
    "websocket_port": 8767,
    "open_browser": true
  },
  "model": {
    "name": "bimanual",
    "version": 1
  },
  "coordination": {
    "side_to_endpoint": {
      "left": "left",
      "right": "right"
    },
    "epoch": "dynamic-fixed-contact-1",
    "max_input_age_s": 0.2
  },
  "environment": {
    "plugin": {
      "name": "object_scene_environment",
      "version": 1
    },
    "parameters": {
      "preset": "fixed_contact"
    },
    "robot_collision_profile": "tool_sphere_10mm/v1"
  },
  "task": {
    "plugin": {
      "name": "contact_observation_task",
      "version": 1
    },
    "parameters": {
      "target_object_ids": [
        "cube"
      ],
      "duration_s": 60.0
    }
  }
}
