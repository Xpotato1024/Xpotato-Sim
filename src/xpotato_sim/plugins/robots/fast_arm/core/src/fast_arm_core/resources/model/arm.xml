<mujoco model="arm">
  <compiler angle="degree" meshdir="meshes" autolimits="true">
    <lengthrange timestep="0.033"/>
  </compiler>
  <!--option integrator="RK4"/-->

  <asset>
    <!-- robot mesh -->
    <mesh file="BaseLink.stl"/>
    <mesh file="SholderLink1.stl"/>
    <mesh file="SholderLink2.stl"/>
    <mesh file="UpperArmLink.stl"/>
    <mesh file="ForeArmLink.stl"/>
    <!-- material -->
    <material name="base_material" rgba="1 1 1 1"/>
    <material name="sholder1_material" rgba="1 1 1 1"/>
    <material name="sholder2_material" rgba="1 1 1 1"/>
    <material name="upper_arm_material" rgba="1 1 1 1"/>
    <material name="fore_arm_material" rgba="1 1 1 1"/>
  </asset>
  
  <default>
  </default>

  <worldbody>
    <!-- robot body description -->
    <body name="origin" pos="0 0 0.7">
      <geom type="sphere" size="0.005" rgba="1 0 0 0.5"/>
    </body>
    <body name="base" pos="0 0 0" euler="0 0 90"> <!-- 長手方向をx軸にするため回転 -->
      <body name="base_link" pos="0 0.069 0.7">
        <inertial pos="0.000008 -0.006193 -0.000016" euler="0 0 0" mass="1.838188" diaginertia="0.001648 0.008801 0.008173"/>
        <geom mesh="BaseLink" type="mesh" pos="0 0 0" contype="0" conaffinity="0" group="2" material="base_material"/>
        <body name="sholder_link_1" pos="0 -0.014 0">
          <geom mesh="SholderLink1" type="mesh" pos="0 0 0" contype="0" conaffinity="0" group="2" material="sholder1_material"/>
          <inertial pos="-0.000036 0.037788 0" mass="0.340914" diaginertia="0.0004742 0.0006607 0.0008554"/>
          <joint name="sholder_joint_1" pos="0 -0.055 0" axis="0 -1 0" armature="0.0003642"/>
          <body name="sholder_link_2" pos="0 -0.131 0">
            <geom mesh="SholderLink2" type="mesh" pos="0 0 0" contype="0" conaffinity="0" group="2" material="sholder2_material"/>
            <inertial pos="0.000025 0.052487 -0.000019" mass="2.183843" diaginertia="0.004049 0.007499 0.009236"/>
            <joint name="sholder_joint_2" pos="0 0.076 0" axis="1 0 0" armature="0.0003642" ref="-90"/>
            <body name="upper_arm_link" pos="0 -0.0115 0">
              <geom mesh="UpperArmLink" type="mesh" pos="0 0 0" contype="0" conaffinity="0" group="2" material="upper_arm_material"/>
              <inertial pos="-0.00076 -0.07145 0.000014" mass="0.836573" diaginertia="0.002496 0.0005635 0.002764"/>
              <joint name="sholder_joint_3" pos="0 0 0" axis="0 -1 0" armature="0.0003642"/>
              <body name="fore_arm_link" pos="0 -0.2505 0">
                <geom mesh="ForeArmLink" type="mesh" pos="0 0 0" contype="0" conaffinity="0" group="2" material="fore_arm_material"/>
                <inertial pos="0.000012 -0.076122 0.001822" mass="0.204549" diaginertia="0.001890 0.00004473 0.001872"/>
                <joint name="elbow_joint" pos="0 0 0" axis="0 0 1" armature="0.0003642"/>
                <site name="tip" pos="0 -0.284 0" rgba="0.0 0.5 0.5 0.5"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <general name="actuator1" joint="sholder_joint_1" ctrlrange="-20 20" dyntype="none" dynprm="1 0 0" gaintype="fixed" gainprm="60" biastype="affine" biasprm="0 -60 -1" forcerange="-24 24"/>
    <general name="actuator2" joint="sholder_joint_2" ctrlrange="-20 20" dyntype="none" dynprm="1 0 0" gaintype="fixed" gainprm="60" biastype="affine" biasprm="0 -60 -1" forcerange="-24 24"/>
    <general name="actuator3" joint="sholder_joint_3" ctrlrange="-20 20" dyntype="none" dynprm="1 0 0" gaintype="fixed" gainprm="30" biastype="affine" biasprm="0 -30 -0.5" forcerange="-12 12"/>
    <general name="actuator4" joint="elbow_joint" ctrlrange="-20 20" dyntype="none" dynprm="1 0 0" gaintype="fixed" gainprm="30" biastype="affine" biasprm="0 -30 -0.5" forcerange="-12 12"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 -0.5235987755982989 0 -1.0471975511965976" ctrl="0 0 0 0"/>
  </keyframe>
</mujoco>
