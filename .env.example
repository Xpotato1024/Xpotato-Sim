# 実設定は just init が作る root .env に置く（この例を実設定として使わない）。
# 相対pathはrepository root基準。空白を含む値は引用する。
XPOTATO_TEMP_ROOT="/absolute/local/workbench-temp"
XPOTATO_RESULT_ROOT="/absolute/local/trial-results"
XPOTATO_WEB_DIST="/absolute/local/workbench-temp/viewer-dist"
XPOTATO_OPEN_BROWSER=true
XPOTATO_WEB_PORT=5173
XPOTATO_BACKEND_PORT=8766
XPOTATO_PYTHON=3.12
